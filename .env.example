# Mossbridge local example configuration.
# Copy this file to .env and fill in local values. Never commit your real .env.

# Runtime and workspace.
ASHERIEBRIDGE_RUNTIME=claudecode
ASHERIEBRIDGE_CLAUDE_MODEL=claude-opus-4-6
ASHERIEBRIDGE_WORKSPACE_ROOT=/absolute/path/to/your/workspace

# WeChat access.
# Fill this after login or after reading the allowed user id from bridge status/logs.
ASHERIEBRIDGE_ALLOWED_USER_IDS=your_wechat_user_id

# Local bridge state: accounts, sessions, stickers, logs, queues.
# Default is ${HOME}/.asheriebridge. For new public deployments, prefer an explicit path.
ASHERIEBRIDGE_STATE_DIR=/absolute/path/to/mossbridge-state

# Lightweight memory warehouse owned by this Mossbridge deployment.
# New users should start with only this one memory path.
ASHERIEBRIDGE_DATA_ROOT=/absolute/path/to/mossbridge-data

# Identity scope for memory files. Keep these stable for one user's warehouse.
ASHERIEBRIDGE_IDENTITY_USER_ID=owner
ASHERIEBRIDGE_IDENTITY_REALM_ID=default
ASHERIEBRIDGE_IDENTITY_AGENT_ID=aji

# Optional proactive wakeups.
ASHERIEBRIDGE_ENABLE_CHECKIN=true
ASHERIEBRIDGE_CHECKIN_MIN_INTERVAL_MS=300000
ASHERIEBRIDGE_CHECKIN_MAX_INTERVAL_MS=1500000

# Optional recall sizes. Defaults are already reasonable for daily chat.
ASHERIEBRIDGE_ASHERIE_CONTEXT_CACHE_LIMIT=50
ASHERIEBRIDGE_ASHERIE_PROACTIVE_CONTEXT_CACHE_LIMIT=50
ASHERIEBRIDGE_ASHERIE_PRELUDE_WARM_LIMIT=6
ASHERIEBRIDGE_ASHERIE_PRELUDE_RESIDENT_WARM_LIMIT=5
ASHERIEBRIDGE_ASHERIE_PRELUDE_ONGOING_LIMIT=5
ASHERIEBRIDGE_ASHERIE_PRELUDE_RECENT_SNIPPET_LIMIT=8
ASHERIEBRIDGE_ASHERIE_PRELUDE_RECENT_THREAD_LIMIT=8

# Migration-only overrides.
# Do not set these for a fresh deploy unless you are intentionally sharing or importing a memory store.
# ASHERIEBRIDGE_ASHERIE_WARM_MEMORY_DIR=/absolute/path/to/existing/warm_memory
# ASHERIEBRIDGE_ASHERIE_TRUTH_LAYER_DIR=/absolute/path/to/existing/truth_layer
# ASHERIEBRIDGE_ASHERIE_MEMORY_TREE_DIR=/absolute/path/to/existing/memory_tree
# ASHERIEBRIDGE_ASHERIE_CASE_INDEX_DIR=/absolute/path/to/existing/case_index
# ASHERIEBRIDGE_ASHERIE_NOTION_SYNC_DIR=/absolute/path/to/existing/notion_sync
# ASHERIEBRIDGE_ASHERIE_APP_DAILY_CAPTURE_DIR=/absolute/path/to/existing/app_daily_captures
# ASHERIEBRIDGE_ASHERIE_MEMORY_VERSION_BANK_DIR=/absolute/path/to/existing/memory_versions
