# Mossbridge local example configuration.
# Copy this file to .env and fill in local values. Never commit your real .env.

# Runtime and workspace. Supported runtimes: codex, claudecode.
# Keep public smoke tests runtime-neutral: run once with codex and once with claudecode.
MOSSBRIDGE_RUNTIME=codex
# Optional Codex runtime controls. Use these to pin a model, route Codex through
# a local provider, or override native image input detection for local models.
# For local providers such as Ollama, copy templates/codex-local-provider.sh
# outside the repo, chmod +x it, and point MOSSBRIDGE_CODEX_COMMAND at the copy.
# MOSSBRIDGE_CODEX_MODEL=
# MOSSBRIDGE_CODEX_MODEL_PROVIDER=
# MOSSBRIDGE_CODEX_NATIVE_IMAGE_INPUT=
# MOSSBRIDGE_CODEX_COMMAND=
# Optional model menu for `/model`. Format: alias=model or alias=model@provider
# for Codex. These are convenience names, not secrets.
# MOSSBRIDGE_MODEL_CHOICES=fast=gpt-5.4-mini
# MOSSBRIDGE_CODEX_MODEL_CHOICES=cloud=gpt-5.4,local=gemma4:26b-32k@ollama
# Required only when MOSSBRIDGE_RUNTIME=claudecode.
# MOSSBRIDGE_CLAUDE_MODEL=claude-opus-4-6
# MOSSBRIDGE_CLAUDE_MODEL_CHOICES=opus=claude-opus-4-6,sonnet=claude-sonnet-4-6
MOSSBRIDGE_WORKSPACE_ROOT=/absolute/path/to/your/workspace

# Claude Code context guardrail. The bridge records usage and can quietly compact
# after a normal reply when the resumed thread is near the configured window.
MOSSBRIDGE_CLAUDE_CONTEXT_WINDOW=200000
MOSSBRIDGE_CLAUDE_AUTO_COMPACT=true
MOSSBRIDGE_CLAUDE_AUTO_COMPACT_THRESHOLD_PERCENT=85
MOSSBRIDGE_CLAUDE_AUTO_COMPACT_MIN_INTERVAL_MS=1800000

# Runtime session pressure guardrail. When a reported runtime thread is near
# the context window, Mossbridge queues one refresh request and applies it on
# the next normal user message, so the model wakes in a fresh thread with the
# opening instructions and compact memory packet. Background system turns do
# not consume the queued refresh. Set percent to 0 to disable.
MOSSBRIDGE_SESSION_REFRESH_PRESSURE_PERCENT=92
MOSSBRIDGE_SESSION_REFRESH_MIN_INTERVAL_MS=1800000

# WeChat access.
# Leave empty for the first isolated login smoke. Fill this after login, once
# you have confirmed the WeChat user id from bridge status/logs.
MOSSBRIDGE_ALLOWED_USER_IDS=
# File/attachment delivery guardrails. Work-case artifacts should usually be
# linked as case artifacts first; large files should use an external handoff.
MOSSBRIDGE_CHANNEL_FILE_MAX_BYTES=20971520
MOSSBRIDGE_CHANNEL_FILE_SEND_TIMEOUT_MS=120000

# Local bridge state: accounts, sessions, stickers, logs, queues, control events.
# Default is ${HOME}/.mossbridge. For testing or public release validation,
# prefer an explicit disposable path so you do not mix accounts or sessions.
# The control ledger is <MOSSBRIDGE_STATE_DIR>/control-events.jsonl.
MOSSBRIDGE_STATE_DIR=/absolute/path/to/mossbridge-state

# Lightweight memory warehouse owned by this Mossbridge deployment.
# This is where hot context, warm memory, notebook notes, ongoing tracks,
# episode/observation journals, conversation cache, case index,
# cold-version compatibility, and mutation logs live.
# New users should start with only this one memory path. Do not point smoke
# tests at an existing personal memory warehouse.
MOSSBRIDGE_DATA_ROOT=/absolute/path/to/mossbridge-data

# Optional notebook override. Leave unset for fresh deploys so small notes and
# diary-like entries live in <MOSSBRIDGE_DATA_ROOT>/storage/notebook.
# Legacy alias MOSSBRIDGE_DIARY_DIR is still accepted for migration.
# MOSSBRIDGE_NOTEBOOK_DIR=/absolute/path/to/notebook

# Public maintenance posture. Default is read-only self-check and report.
# Private deployers can opt in to safe self-repair explicitly.
MOSSBRIDGE_MAINTENANCE_PROFILE=safe_self_check
MOSSBRIDGE_MAINTENANCE_ALLOW_SELF_REPAIR=false

# Sticker catalog. If MOSSBRIDGE_DATA_ROOT is set and this is omitted, the
# bridge uses <MOSSBRIDGE_DATA_ROOT>/storage/stickers. Leave both unset for a
# fully standalone install; then stickers stay under <MOSSBRIDGE_STATE_DIR>/stickers.
# MOSSBRIDGE_STICKERS_DIR=/absolute/path/to/stickers

# Identity scope for memory files. Keep these stable for one user's warehouse.
# user_id is the human scope, realm_id separates deployments or relationships,
# and agent_id separates the assistant/persona lineage writing the memory.
MOSSBRIDGE_IDENTITY_USER_ID=owner
MOSSBRIDGE_IDENTITY_REALM_ID=default
MOSSBRIDGE_IDENTITY_AGENT_ID=moss

# Optional proactive wakeups. These are model wakeup chances, not bare alarms:
# the bridge can attach memory context, inspect read-only health, and choose
# message / silent note / reminder / no-op according to the current situation.
MOSSBRIDGE_ENABLE_CHECKIN=true
MOSSBRIDGE_CHECKIN_MIN_INTERVAL_MS=300000
MOSSBRIDGE_CHECKIN_MAX_INTERVAL_MS=1500000
# Stretch random wakeups when the runtime context is already heavy.
MOSSBRIDGE_CHECKIN_TOKEN_BACKOFF_PERCENT=40
MOSSBRIDGE_CHECKIN_TOKEN_SEVERE_BACKOFF_PERCENT=60
MOSSBRIDGE_CHECKIN_TOKEN_BACKOFF_MULTIPLIER=3
MOSSBRIDGE_CHECKIN_TOKEN_SEVERE_BACKOFF_MULTIPLIER=6
MOSSBRIDGE_CHECKIN_MAX_BACKOFF_MINUTES=120
# Code-level patrols may run often, but random model wakeups are gated so an
# empty heartbeat does not call Codex/Claude every 5-25 minutes. AI-calendar
# reminders and dreaming/task wakeups are not blocked by this random gap.
MOSSBRIDGE_CHECKIN_MODEL_MIN_GAP_MINUTES=90
# Random proactive wakeups pause during sleep hours, so the bridge does not
# encourage late-night staying up. Morning grace lets a wakeup try a slightly
# older WeChat token after quiet hours, restoring the "wake up to a note" feel.
MOSSBRIDGE_CHECKIN_QUIET_HOURS=02:00-07:00
MOSSBRIDGE_CHECKIN_MORNING_CONTEXT_TOKEN_GRACE_HOURS=07:00-10:30
MOSSBRIDGE_CHECKIN_MORNING_CONTEXT_TOKEN_MAX_AGE_MINUTES=720
# Daily check-in budget uses weighted tokens: fresh tokens count fully,
# cache-read tokens count lightly by default so cache hits do not freeze the whole day.
MOSSBRIDGE_CHECKIN_DAILY_TOKEN_BUDGET=300000
MOSSBRIDGE_CHECKIN_DAILY_THREAD_BUDGET=36
MOSSBRIDGE_CHECKIN_DAILY_CACHE_READ_WEIGHT=0.1
# When the daily background budget is exhausted: random wakeups stop, dreaming
# retries later, and due reminders still run but with compact system context.
MOSSBRIDGE_SYSTEM_BUDGET_DREAMING_DEFER_MINUTES=20
MOSSBRIDGE_SYSTEM_BUDGET_COMPACT_RUNTIME_TEXT_MAX_CHARS=6000
# If background checkin/dreaming system turns repeatedly fail before the runtime
# emits its first event, briefly stop scheduling those background turns. Normal
# user messages still surface diagnostics instead of being hidden by this guard.
MOSSBRIDGE_BACKGROUND_RUNTIME_CIRCUIT=true
MOSSBRIDGE_BACKGROUND_RUNTIME_CIRCUIT_FAILURE_THRESHOLD=3
MOSSBRIDGE_BACKGROUND_RUNTIME_CIRCUIT_COOLDOWN_MINUTES=45
# Skip random wakeups while the user and assistant are already in an active chat.
MOSSBRIDGE_CHECKIN_HOT_WINDOW_MINUTES=20
MOSSBRIDGE_CHECKIN_HOT_RECENT_MINUTES=12
MOSSBRIDGE_CHECKIN_HOT_MIN_EVENTS=6

# Optional quiet-window memory metabolism / dreaming. This is bridge-owned:
# Mossbridge decides when the user is quiet, queues a system turn, and requires
# a receipt before marking the pass complete. Codex and Claude Code both execute
# the same tool contract.
MOSSBRIDGE_ENABLE_DREAMING=false
MOSSBRIDGE_DREAMING_POLL_INTERVAL_MINUTES=15
MOSSBRIDGE_DREAMING_QUIET_MINUTES=45
MOSSBRIDGE_DREAMING_RETRY_MINUTES=20
MOSSBRIDGE_DREAMING_WINDOW_HOURS=24
MOSSBRIDGE_DREAMING_MIN_SOURCE_RECORDS=2
MOSSBRIDGE_DREAMING_MAX_SOURCE_RECORDS=24

# Optional recall sizes. Defaults are intentionally small. They keep memory
# delivery grounded and fit inside runtime context instead of flooding every
# WeChat turn with the whole warehouse.
MOSSBRIDGE_ASHERIE_CONTEXT_CACHE_LIMIT=50
MOSSBRIDGE_ASHERIE_PROACTIVE_CONTEXT_CACHE_LIMIT=50
MOSSBRIDGE_ASHERIE_PRELUDE_WARM_LIMIT=6
MOSSBRIDGE_ASHERIE_PRELUDE_RESIDENT_WARM_LIMIT=5
MOSSBRIDGE_ASHERIE_PRELUDE_AMBIENT_WARM_LIMIT=2
MOSSBRIDGE_ASHERIE_PRELUDE_ONGOING_LIMIT=5
MOSSBRIDGE_ASHERIE_PRELUDE_HOT_UPSTREAM_LIMIT=4
MOSSBRIDGE_ASHERIE_PRELUDE_HOT_TURN_LIMIT=6
MOSSBRIDGE_ASHERIE_PRELUDE_HOT_SNAPSHOT_LIMIT=2
MOSSBRIDGE_ASHERIE_PRELUDE_LOCAL_ARCHIVE_LIMIT=2
MOSSBRIDGE_ASHERIE_PRELUDE_RECENT_SNIPPET_LIMIT=8
MOSSBRIDGE_ASHERIE_PRELUDE_RECENT_THREAD_LIMIT=8

# Migration-only overrides. The ASHERIE segment is historical memory-domain
# naming, not a dependency on a private Home system. Do not set these for a
# fresh deploy unless you are intentionally sharing or importing an existing
# memory store into this data root.
# MOSSBRIDGE_ASHERIE_WARM_MEMORY_DIR=/absolute/path/to/existing/warm_memory
# MOSSBRIDGE_ASHERIE_OBSERVATION_JOURNAL_DIR=/absolute/path/to/existing/observation_journal
# MOSSBRIDGE_ASHERIE_SOLITUDE_JOURNAL_DIR=/absolute/path/to/existing/solitude_journal
# MOSSBRIDGE_ASHERIE_TRUTH_LAYER_DIR=/absolute/path/to/existing/truth_layer
# MOSSBRIDGE_ASHERIE_MEMORY_TREE_DIR=/absolute/path/to/existing/memory_tree
# MOSSBRIDGE_ASHERIE_CASE_INDEX_DIR=/absolute/path/to/existing/case_index
# MOSSBRIDGE_ASHERIE_MEMORY_VERSION_BANK_DIR=/absolute/path/to/existing/memory_versions
