# Mossbridge local example configuration.
# Copy this file to .env and fill in local values. Never commit your real .env.

# Runtime and workspace. Supported runtimes: codex, claudecode.
# Keep public smoke tests runtime-neutral: run once with codex and once with claudecode.
MOSSBRIDGE_RUNTIME=codex
# Required only when MOSSBRIDGE_RUNTIME=claudecode.
# MOSSBRIDGE_CLAUDE_MODEL=claude-opus-4-6
MOSSBRIDGE_WORKSPACE_ROOT=/absolute/path/to/your/workspace

# Claude Code context guardrail. The bridge records usage and can quietly compact
# after a normal reply when the resumed thread is near the configured window.
MOSSBRIDGE_CLAUDE_CONTEXT_WINDOW=200000
MOSSBRIDGE_CLAUDE_AUTO_COMPACT=true
MOSSBRIDGE_CLAUDE_AUTO_COMPACT_THRESHOLD_PERCENT=85
MOSSBRIDGE_CLAUDE_AUTO_COMPACT_MIN_INTERVAL_MS=1800000

# WeChat access.
# Leave empty for the first isolated login smoke. Fill this after login, once
# you have confirmed the WeChat user id from bridge status/logs.
MOSSBRIDGE_ALLOWED_USER_IDS=

# Local bridge state: accounts, sessions, stickers, logs, queues.
# Default is ${HOME}/.mossbridge. For testing or public release validation,
# prefer an explicit disposable path so you do not mix accounts or sessions.
MOSSBRIDGE_STATE_DIR=/absolute/path/to/mossbridge-state

# Lightweight memory warehouse owned by this Mossbridge deployment.
# This is where warm memory, ongoing tracks, episode/observation journals,
# conversation cache, future ChatGPT web/app captures, and mutation logs live.
# New users should start with only this one memory path. Do not point smoke
# tests at an existing personal memory warehouse.
MOSSBRIDGE_DATA_ROOT=/absolute/path/to/mossbridge-data

# Public maintenance posture. Default is read-only self-check and report.
# Private deployers can opt in to safe self-repair explicitly.
MOSSBRIDGE_MAINTENANCE_PROFILE=safe_self_check
MOSSBRIDGE_MAINTENANCE_ALLOW_SELF_REPAIR=false

# Sticker catalog. If MOSSBRIDGE_DATA_ROOT is set and this is omitted, the
# bridge uses <MOSSBRIDGE_DATA_ROOT>/storage/stickers. Leave both unset for a
# fully standalone install; then stickers stay under <MOSSBRIDGE_STATE_DIR>/stickers.
# MOSSBRIDGE_STICKERS_DIR=/absolute/path/to/stickers

# Identity scope for memory files. Keep these stable for one user's warehouse.
# user_id is the human scope, realm_id separates deployments or relationships,
# and agent_id separates the assistant/persona lineage writing the memory.
MOSSBRIDGE_IDENTITY_USER_ID=owner
MOSSBRIDGE_IDENTITY_REALM_ID=default
MOSSBRIDGE_IDENTITY_AGENT_ID=moss

# Optional proactive wakeups. These are model wakeup chances, not bare alarms:
# the bridge can attach memory context, inspect read-only health, and choose
# message / silent note / reminder / no-op according to the current situation.
MOSSBRIDGE_ENABLE_CHECKIN=true
MOSSBRIDGE_CHECKIN_MIN_INTERVAL_MS=300000
MOSSBRIDGE_CHECKIN_MAX_INTERVAL_MS=1500000
# Stretch random wakeups when the runtime context is already heavy.
MOSSBRIDGE_CHECKIN_TOKEN_BACKOFF_PERCENT=40
MOSSBRIDGE_CHECKIN_TOKEN_SEVERE_BACKOFF_PERCENT=60
MOSSBRIDGE_CHECKIN_TOKEN_BACKOFF_MULTIPLIER=3
MOSSBRIDGE_CHECKIN_TOKEN_SEVERE_BACKOFF_MULTIPLIER=6
MOSSBRIDGE_CHECKIN_MAX_BACKOFF_MINUTES=120
# Skip random wakeups while the user and assistant are already in an active chat.
MOSSBRIDGE_CHECKIN_HOT_WINDOW_MINUTES=20
MOSSBRIDGE_CHECKIN_HOT_RECENT_MINUTES=12
MOSSBRIDGE_CHECKIN_HOT_MIN_EVENTS=6

# Optional recall sizes. Defaults are intentionally small. They keep memory
# delivery grounded and fit inside runtime context instead of flooding every
# WeChat turn with the whole warehouse.
MOSSBRIDGE_ASHERIE_CONTEXT_CACHE_LIMIT=50
MOSSBRIDGE_ASHERIE_PROACTIVE_CONTEXT_CACHE_LIMIT=50
MOSSBRIDGE_ASHERIE_PRELUDE_WARM_LIMIT=6
MOSSBRIDGE_ASHERIE_PRELUDE_RESIDENT_WARM_LIMIT=5
MOSSBRIDGE_ASHERIE_PRELUDE_ONGOING_LIMIT=5
MOSSBRIDGE_ASHERIE_PRELUDE_RECENT_SNIPPET_LIMIT=8
MOSSBRIDGE_ASHERIE_PRELUDE_RECENT_THREAD_LIMIT=8

# Migration-only overrides. The ASHERIE segment is historical memory-domain
# naming, not a dependency on a private Home system. Do not set these for a
# fresh deploy unless you are intentionally sharing or importing an existing
# memory store into this data root.
# MOSSBRIDGE_ASHERIE_WARM_MEMORY_DIR=/absolute/path/to/existing/warm_memory
# MOSSBRIDGE_ASHERIE_OBSERVATION_JOURNAL_DIR=/absolute/path/to/existing/observation_journal
# MOSSBRIDGE_ASHERIE_SOLITUDE_JOURNAL_DIR=/absolute/path/to/existing/solitude_journal
# MOSSBRIDGE_ASHERIE_TRUTH_LAYER_DIR=/absolute/path/to/existing/truth_layer
# MOSSBRIDGE_ASHERIE_MEMORY_TREE_DIR=/absolute/path/to/existing/memory_tree
# MOSSBRIDGE_ASHERIE_CASE_INDEX_DIR=/absolute/path/to/existing/case_index
# MOSSBRIDGE_ASHERIE_NOTION_SYNC_DIR=/absolute/path/to/existing/notion_sync
# MOSSBRIDGE_ASHERIE_APP_DAILY_CAPTURE_DIR=/absolute/path/to/existing/app_daily_captures
# MOSSBRIDGE_ASHERIE_MEMORY_VERSION_BANK_DIR=/absolute/path/to/existing/memory_versions
